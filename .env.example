# Site URL (used in admin email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudinary — for image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
# Required for media management (listing + deleting images from Cloudinary)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Supabase — get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — get these from your Razorpay Dashboard → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# SMTP — for order confirmation emails
# Use Gmail: enable 2FA → Google Account → Security → App Passwords → create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Admin email for order notifications
ADMIN_EMAIL=almasladiescornersakchi@gmail.com

# Optional: comma-separated admin email addresses (beyond the hardcoded ones)
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com
